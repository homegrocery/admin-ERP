# Home Grocery Admin ERP - Environment Configuration

# Canonical Production URL of the Admin ERP frontend
VITE_ADMIN_ERP_URL=https://homegrocery.github.io/admin-ERP/

# Separate Backend API Base URL (Render Web Service or Custom Domain)
# Leave empty for local development (which uses Vite proxy to http://127.0.0.1:3001)
# VITE_API_BASE_URL=https://home-grocery-api.onrender.com
VITE_API_BASE_URL=https://home-grocery-api.onrender.com
